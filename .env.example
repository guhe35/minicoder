# Copy this file to .env, then replace only the API key.
# Never commit the real .env file or show it in a recording.
MODEL_API_URL=https://api.deepseek.com/chat/completions
MODEL_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
MODEL_NAME=deepseek-v4-pro
MODEL_THINKING=enabled
MODEL_REASONING_EFFORT=high
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2
